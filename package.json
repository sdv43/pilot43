{
  "name": "Pilot43",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "e2e": "npm run build && playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "npm run build && playwright test --debug",
    "e2e:headed": "npm run build && playwright test --headed",
    "e2e:install": "playwright install chromium",
    "lint:js": "eslint .",
    "lint:css": "stylelint '**/*.{css,scss}'",
    "preview": "vite preview",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .git-hooks",
    "test": "vitest",
    "test:run": "vitest run",
    "test:node": "node --test scripts/*.test.js",
    "check-unused-css": "node scripts/check-unused-css.js",
    "sync:version": "node scripts/sync-version.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@openrouter/sdk": "^1.2.27",
    "@tanstack/react-query": "^5.100.7",
    "classnames": "^2.5.1",
    "idb": "^8.0.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.11.0",
    "modern-json-react": "^1.2.0",
    "ollama": "^0.6.3",
    "openai": "^6.36.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@crxjs/vite-plugin": "^2.4.0",
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/eslint-plugin-query": "^5.100.7",
    "@types/babel__core": "^7.20.5",
    "@types/chrome": "^0.1.40",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.9.1",
    "stylelint-config-clean-order": "^8.0.1",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "stylelint-order": "^8.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,json,css,md,html}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix",
    "*.css": "stylelint --fix"
  }
}
