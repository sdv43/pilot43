{
  "name": "Pilot43",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "e2e": "npm run build && playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "npm run build && playwright test --debug",
    "e2e:headed": "npm run build && playwright test --headed",
    "e2e:install": "playwright install chromium",
    "lint:js": "eslint .",
    "lint:css": "stylelint '**/*.{css,scss}'",
    "preview": "vite preview",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .git-hooks",
    "test": "vitest",
    "test:run": "vitest run",
    "test:node": "node --test scripts/*.test.js",
    "check-unused-css": "node scripts/check-unused-css.js",
    "sync:version": "node scripts/sync-version.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@openrouter/sdk": "^1.2.54",
    "@tanstack/react-query": "^5.102.0",
    "classnames": "^2.5.1",
    "idb": "^8.0.3",
    "katex": "^0.18.4",
    "lucide-react": "^1.33.0",
    "ollama": "^0.6.3",
    "openai": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/eslint-plugin-query": "^5.102.0",
    "@types/babel__core": "^7.20.5",
    "@types/chrome": "^0.2.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,json,css,md,html}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix",
    "*.css": "stylelint --fix"
  }
}
